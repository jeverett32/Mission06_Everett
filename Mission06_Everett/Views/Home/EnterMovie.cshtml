@*
    Form for adding or editing movies in the collection
*@

@model Movie

<h1>Add Movie to Collection</h1>

<form method="post">
    @* Hidden field for MovieId (used when editing existing movies) *@
    <input type="hidden" asp-for="MovieId" />

    @* Category dropdown populated from database *@
    <select asp-for="CategoryId" required>
        <option value="">Select a Category</option>
        @foreach (Category category in ViewBag.Categories)
        {
            <option value="@category.CategoryId">@category.CategoryName</option>
        }
    </select><br />

    <label asp-for="Title">Title:</label>
    <input asp-for="Title" required /><br />

    <label asp-for="Year">Year:</label>
    <input asp-for="Year" required /><br />

    <label asp-for="Director">Director:</label>
    <input asp-for="Director" /><br />

    <label asp-for="Rating">Rating:</label>
    @* MPAA movie ratings dropdown *@
    <select asp-for="Rating">
        <option value="">Select a Rating</option>
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
    </select><br />

    <label asp-for="Edited">Edited:</label>
    <select asp-for="Edited">
        <option value="false">No</option>
        <option value="true">Yes</option>
    </select><br />

    <label asp-for="LentTo">Lent To:</label>
    <input asp-for="LentTo" /><br />

    <label asp-for="CopiedToPlex">Copied To Plex:</label>
    <input asp-for="CopiedToPlex" required/><br />

    <label asp-for="Notes">Notes (Max 25 chars):</label>
    <textarea asp-for="Notes" maxlength="25"></textarea><br />

    <button type="submit">Add Movie</button>
</form>
